# ==============================================
# GESHER DISTRIBUTION - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# ==============================================

# ----------------------------------------------
# APPLICATION
# ----------------------------------------------
NEXT_PUBLIC_APP_NAME="Gesher Distribution"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ----------------------------------------------
# SUPABASE
# ----------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (DO NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------------------------
# DATABASE
# ----------------------------------------------
# Get the connection string from Supabase Dashboard > Settings > Database
#
# IMPORTANT: For best performance, use the POOLER connection (port 6543):
# - Transaction mode pooler is recommended for serverless/Next.js apps
# - Direct connection (port 5432) causes slow SSL handshakes on each request
#
# Pooler URL format (RECOMMENDED for app):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for migrations only - NOT for app queries):
# Use this ONLY for running migrations with drizzle-kit or similar tools
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ----------------------------------------------
# AUTHENTICATION
# ----------------------------------------------
# Session configuration
AUTH_SESSION_DURATION=86400
AUTH_REFRESH_THRESHOLD=3600

# ----------------------------------------------
# QUICKBOOKS ONLINE INTEGRATION
# ----------------------------------------------
# Get these from: https://developer.intuit.com/app/developer/dashboard
# 1. Create an app in the Intuit Developer Portal
# 2. Go to Keys & OAuth > Development/Production settings
# 3. Copy Client ID and Client Secret
# 4. Set redirect URI to: http://localhost:3000/api/quickbooks/callback

# OAuth credentials
NEXT_QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
NEXT_QUICKBOOKS_SECRET_ID=your_quickbooks_client_secret
NEXT_QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback

# Environment: 'sandbox' or 'production'
NEXT_QUICKBOOKS_ENVIRONMENT=sandbox

# Encryption key for storing tokens (32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QBO_ENCRYPTION_KEY=790328d6bc9bffa9e4dea1e10700e009bc0f1fd2cba41cc3a9370d55286ec600

# ----------------------------------------------
# PIPEDRIVE INTEGRATION
# ----------------------------------------------
# PIPEDRIVE_API_TOKEN=

# ----------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
